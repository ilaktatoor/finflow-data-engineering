# FinFlow local environment. Copy to `.env` (`make setup` does it) and adjust.
# ALL CREDENTIALS BELOW ARE LOCAL DEVELOPMENT PLACEHOLDERS. Never reuse them,
# never expose these services beyond 127.0.0.1, never put real secrets here.

# ---------------------------------------------------------------- execution
# lightweight = local files + DuckDB (no Docker); data = MinIO + PostgreSQL + API
FINFLOW_MODE=lightweight
# FINFLOW_DATA_DIR=./data
# FINFLOW_LOG_LEVEL=INFO

# ------------------------------------------------- data profile (host side)
# Used by the host CLI with --mode data. Ports are bound to 127.0.0.1 only.
FINFLOW_S3_ENDPOINT=http://127.0.0.1:9000
FINFLOW_S3_ACCESS_KEY=finflow-local
FINFLOW_S3_SECRET_KEY=change-me-local-only-minio
FINFLOW_S3_BUCKET=finflow-lake
FINFLOW_WAREHOUSE_URL=postgresql+psycopg://finflow:change-me-local-only-wh@127.0.0.1:5434/warehouse
FINFLOW_OPS_DB_URL=postgresql+psycopg://bank_app:change-me-local-only-ops@127.0.0.1:5433/operational
FINFLOW_SOURCE_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------ container settings
OPS_DB_USER=bank_app
OPS_DB_PASSWORD=change-me-local-only-ops
WAREHOUSE_DB_USER=finflow
WAREHOUSE_DB_PASSWORD=change-me-local-only-wh
AIRFLOW_DB_PASSWORD=change-me-local-only-airflow
METABASE_DB_PASSWORD=change-me-local-only-metabase
ANALYTICS_READER_PASSWORD=change-me-local-only-reader
MINIO_ROOT_USER=finflow-local
MINIO_ROOT_PASSWORD=change-me-local-only-minio

# Airflow runs as this host UID so files it writes under ./data stay yours.
# Set it with: echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=1000
# Login for the Airflow UI (simple auth manager, local only).
AIRFLOW_ADMIN_PASSWORD=change-me-local-only-admin
# Metabase admin created by scripts/metabase_setup.py
METABASE_ADMIN_EMAIL=admin@finflow.local
METABASE_ADMIN_PASSWORD=change-me-local-only-mb1
